-- =================================================================

local CONFIG = {
	StandardPhrases = {
		"you are so intriguing",
		"i see you",
		"don't look away"
	},
	SoloPhrases = {
		"you are entirely alone",
		"no one can hear you",
		"the void remembers",
		"abandoned"
	},
	ChasePhrases = {
		"we shall become one"
	},
	SpawnCheckInterval = 1.5,
	BaseSpawnChance = 20,
	SoloSpawnChanceMultiplier = 2,
	MinSpawnDistance = 10,
	MaxSpawnDistance = 22,
	StandardPenalty = 15,
	SoloPenalty = 25,
	ChatTriggerRange = 6,
	FadeDuration = 2.0,
	
	-- [REDACTED] Chase Configuration
	SoloLifespan = 30,         -- Despawns after 30 seconds if alone
	StareDurationToTrigger = 5, -- Looking at it for 5 seconds triggers the chase
	ChaseDuration = 10,        -- Chase lasts for 10 seconds max
	CatchDistance = 3,         -- Distance to trigger being caught
	DamageAmount = 60,         -- Damage dealt if caught
	BaseChaseSpeed = 16,       -- Initial chase walkspeed
	MaxChaseSpeed = 28         -- Maximum chase walkspeed
}

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local ChatService = game:GetService("Chat")
local TweenService = game:GetService("TweenService")
local Camera = workspace.CurrentCamera

local localPlayer = Players.LocalPlayer
local activeClones = {}
local isGlitching = false

local CloneModule = {}

local function getRandomPhrase(isSolo)
	local list = isSolo and CONFIG.SoloPhrases or CONFIG.StandardPhrases
	return list[math.random(1, #list)]
end

local function scrambleText(text)
	local scrambled = ""
	for c = 1, #text do
		local char = text:sub(c, c)
		if char ~= " " and math.random() > 0.2 then
			scrambled = scrambled .. string.char(math.random(33, 126))
		else
			scrambled = scrambled .. char
		end
	end
	return scrambled
end

local function fadeOutClone(cloneInstance)
	if not cloneInstance or not cloneInstance.Parent then return end
	
	local tweenInfo = TweenInfo.new(CONFIG.FadeDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	
	for _, desc in ipairs(cloneInstance:GetDescendants()) do
		if desc:IsA("BasePart") then
			TweenService:Create(desc, tweenInfo, {Transparency = 1}):Play()
		elseif desc:IsA("Decal") or desc:IsA("Texture") then
			TweenService:Create(desc, tweenInfo, {Transparency = 1}):Play()
		end
	end
	
	task.delay(CONFIG.FadeDuration + 0.1, function()
		if cloneInstance and cloneInstance.Parent then
			cloneInstance:Destroy()
		end
	end)
end

local function triggerPenalty(cloneInstance, sanityModule, isSolo)
	if isGlitching then return end
	isGlitching = true
	
	local penaltyAmount = isSolo and CONFIG.SoloPenalty or CONFIG.StandardPenalty
	if sanityModule and sanityModule.ModifySanity then
		sanityModule:ModifySanity(-penaltyAmount)
	end
	
	fadeOutClone(cloneInstance)
	
	task.spawn(function()
		local endTime = tick() + 5
		while tick() < endTime do
			local colorCorr = Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
			if not colorCorr then
				colorCorr = Instance.new("ColorCorrectionEffect")
				colorCorr.Parent = Lighting
			end
			colorCorr.TintColor = isSolo and Color3.fromRGB(100, 0, 150) or Color3.fromRGB(200, 0, 255)
			colorCorr.Saturation = -3
			colorCorr.Contrast = 2
			Camera.CFrame = Camera.CFrame * CFrame.new(math.random(-1, 1) * 0.4, math.random(-1, 1) * 0.4, 0)
			RunService.RenderStepped:Wait()
		end
		local colorCorr = Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
		if colorCorr then
			colorCorr.TintColor = Color3.fromRGB(255, 255, 255)
			colorCorr.Saturation = 0
			colorCorr.Contrast = 0
		end
		isGlitching = false
	end)
end

-- Triggered when [REDACTED] catches the player during a chase
local function triggerCatch(cloneInstance)
	if not cloneInstance or not cloneInstance.Parent then return end
	
	local head = cloneInstance:FindFirstChild("Head")
	if head then
		ChatService:Chat(head, "we shall become one", Enum.ChatColor.Red)
	end
	
	local localChar = localPlayer.Character
	if localChar then
		local humanoid = localChar:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.Health = math.max(0, humanoid.Health - CONFIG.DamageAmount)
		end
	end
	
	fadeOutClone(cloneInstance)
end

function CloneModule:Init(sanityModule)
	task.spawn(function()
		while true do
			task.wait(CONFIG.SpawnCheckInterval)
			
			local currentSanity = sanityModule:GetSanity()
			local scaleFactor = math.clamp(currentSanity / 100, 0.1, 1)
			
			local isSoloServer = (#Players:GetPlayers() == 1)
			local baseChance = isSoloServer and (CONFIG.BaseSpawnChance * CONFIG.SoloSpawnChanceMultiplier) or CONFIG.BaseSpawnChance
			local chanceThreshold = math.floor(baseChance * scaleFactor)
			
			if math.random(1, chanceThreshold) == 1 then
				local localChar = localPlayer.Character
				if localChar and localChar:FindFirstChild("HumanoidRootPart") then
					local targetChar = nil
					
					if isSoloServer then
						localChar.Archivable = true
						targetChar = localChar:Clone()
						localChar.Archivable = false
					else
						local otherPlayers = {}
						for _, p in ipairs(Players:GetPlayers()) do
							if p ~= localPlayer and p.Character then
								local hrp = p.Character:FindFirstChild("HumanoidRootPart")
								local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
								if hrp and humanoid and humanoid.Health > 0 then
									table.insert(otherPlayers, p)
								end
							end
						end
						
						if #otherPlayers > 0 then
							local targetPlayer = otherPlayers[math.random(1, #otherPlayers)]
							if targetPlayer and targetPlayer.Character then
								targetPlayer.Character.Archivable = true
								targetChar = targetPlayer.Character:Clone()
								targetPlayer.Character.Archivable = false
							end
						end
					end
					
					if targetChar then
						local cloneName = isSoloServer and "VoidClone" or "WrongClone"
						targetChar.Name = cloneName
						
						for _, child in ipairs(targetChar:GetDescendants()) do
							if child:IsA("Script") or child:IsA("LocalScript") then
								child:Destroy()
							end
						end
						
						for _, child in ipairs(targetChar:GetChildren()) do
							if child:IsA("Accessory") and not isSoloServer and math.random() > 0.4 then
								child:Destroy()
							end
						end
						
						for _, part in ipairs(targetChar:GetDescendants()) do
							if part:IsA("BasePart") then
								if isSoloServer then
									part.Color = Color3.fromRGB(0, 0, 0)
									part.Material = Enum.Material.SmoothPlastic
								else
									part.Color = part.Color:Lerp(Color3.fromRGB(130, 20, 160), 0.35)
								end
								part.CanCollide = false
							elseif part:IsA("Decal") or part:IsA("Texture") then
								if isSoloServer then
									part.Transparency = 0.8
								end
							end
						end
						
						-- Ensure a humanoid exists for pathfinding/movement during chases
						local humanoid = targetChar:FindFirstChildOfClass("Humanoid")
						if not humanoid then
							humanoid = Instance.new("Humanoid")
							humanoid.Parent = targetChar
						end
						
						local localRoot = localChar.HumanoidRootPart
						local spawnPos
						local validSpawn = false
						local attempts = 0
						
						repeat
							attempts = attempts + 1
							local randomAngle = math.random() * math.pi * 2
							local randomDist = math.random(CONFIG.MinSpawnDistance, CONFIG.MaxSpawnDistance)
							local rayOrigin = localRoot.Position + Vector3.new(math.cos(randomAngle) * randomDist, 10, math.sin(randomAngle) * randomDist)
							
							local raycastParams = RaycastParams.new()
							raycastParams.FilterDescendantsInstances = {localChar}
							raycastParams.FilterType = Enum.RaycastFilterType.Exclude
							
							local rayResult = Workspace:Raycast(rayOrigin, Vector3.new(0, -25, 0), raycastParams)
							if rayResult then
								spawnPos = rayResult.Position
								if (spawnPos - localRoot.Position).Magnitude >= (CONFIG.MinSpawnDistance - 2) then
									validSpawn = true
								end
							end
						until validSpawn or attempts > 5
						
						if not spawnPos then
							spawnPos = localRoot.Position + Vector3.new(12, 0, 0)
						end
						
						targetChar:PivotTo(CFrame.new(spawnPos + Vector3.new(0, 3, 0)))
						targetChar.Parent = Workspace
						
						local cloneData = {
							Instance = targetChar,
							IsSoloVariant = isSoloServer,
							SpawnTick = tick(),
							StareTime = 0,
							IsChasing = false,
							ChaseStartTime = 0,
						}
						table.insert(activeClones, cloneData)
						
						local lifespan = isSoloServer and CONFIG.SoloLifespan or 8
						task.delay(lifespan, function()
							if targetChar and targetChar.Parent and not cloneData.IsChasing then
								fadeOutClone(targetChar)
							end
						end)
					end
				end
			end
		end
	end)
	
	local function handleChatInteraction()
		local localChar = localPlayer.Character
		if not localChar or not localChar:FindFirstChild("HumanoidRootPart") then return end
		local localPos = localChar.HumanoidRootPart.Position
		
		for _, cloneData in ipairs(activeClones) do
			local clone = cloneData.Instance
			if clone and clone.Parent and clone:FindFirstChild("Head") and clone:FindFirstChild("HumanoidRootPart") then
				local cloneRoot = clone.HumanoidRootPart
				
				if (cloneRoot.Position - localPos).Magnitude <= CONFIG.ChatTriggerRange then
					local phrase = getRandomPhrase(cloneData.IsSoloVariant)
					local scrambled = scrambleText(phrase)
					ChatService:Chat(clone.Head, scrambled, Enum.ChatColor.Red)
					break
				end
			end
		end
	end

	localPlayer.Chatted:Connect(handleChatInteraction)

	local TextChatService = game:GetService("TextChatService")
	if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
		local channels = TextChatService:FindFirstChild("TextChannels")
		if channels then
			local generalChannel = channels:FindFirstChild("RBXGeneral")
			if generalChannel then
				generalChannel.MessageReceived:Connect(function(textChatMessage)
					if textChatMessage.TextSource and textChatMessage.TextSource.UserId == localPlayer.UserId then
						handleChatInteraction()
					end
				end)
			end
		end
	end
	
	RunService.RenderStepped:Connect(function(dt)
		local localChar = localPlayer.Character
		if not localChar or not localChar:FindFirstChild("HumanoidRootPart") then return end
		local localRoot = localChar.HumanoidRootPart
		local localPos = localRoot.Position
		
		for i = #activeClones, 1, -1 do
			local cloneData = activeClones[i]
			local clone = cloneData.Instance
			
			if clone and clone.Parent and clone:FindFirstChild("Head") and clone:FindFirstChild("HumanoidRootPart") then
				local cloneRoot = clone.HumanoidRootPart
				local cloneHumanoid = clone:FindFirstChildOfClass("Humanoid")
				
				-- Handle [REDACTED] Solo Chase Mechanics
				if cloneData.IsSoloVariant then
					if not cloneData.IsChasing then
						-- Check if player is looking at the clone (Camera look vector dot product check)
						local cameraCFrame = Camera.CFrame
						local lookVector = cameraCFrame.LookVector
						local directionToClone = (cloneRoot.Position - cameraCFrame.Position).Unit
						local dotProduct = lookVector:Dot(directionToClone)
						
						-- If looking roughly toward the clone (within ~45 degrees) and within range
						if dotProduct > 0.7 and (cloneRoot.Position - localPos).Magnitude < 35 then
							cloneData.StareTime = cloneData.StareTime + dt
							if cloneData.StareTime >= CONFIG.StareDurationToTrigger then
								cloneData.IsChasing = true
								cloneData.ChaseStartTime = tick()
							end
						else
							-- Decay stare time slowly if looking away
							cloneData.StareTime = math.max(0, cloneData.StareTime - (dt * 0.5))
						end
					else
						-- During Chase State
						local chaseElapsed = tick() - cloneData.ChaseStartTime
						if chaseElapsed >= CONFIG.ChaseDuration then
							-- Chase ends after 10 seconds, despawn clone
							table.remove(activeClones, i)
							fadeOutClone(clone)
						else
							-- Calculate progressive speed and void screen effect
							local chaseProgress = chaseElapsed / CONFIG.ChaseDuration
							local currentSpeed = CONFIG.BaseChaseSpeed + (CONFIG.MaxChaseSpeed - CONFIG.BaseChaseSpeed) * chaseProgress
							
							if cloneHumanoid then
								cloneHumanoid:MoveTo(localPos)
								cloneHumanoid.WalkSpeed = currentSpeed
							end
							
							-- Fill screen with void/darkness effect proportional to proximity/progress
							local colorCorr = Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
							if not colorCorr then
								colorCorr = Instance.new("ColorCorrectionEffect")
								colorCorr.Parent = Lighting
							end
							colorCorr.TintColor = Color3.fromRGB(15 + math.floor(40 * (1 - chaseProgress)), 0, 30)
							colorCorr.Saturation = -1 - (chaseProgress * 3)
							colorCorr.Contrast = 1 + (chaseProgress * 2)
							
							-- Check if clone catches the player
							if (cloneRoot.Position - localPos).Magnitude < CONFIG.CatchDistance then
								table.remove(activeClones, i)
								-- Reset color correction
								colorCorr.TintColor = Color3.fromRGB(255, 255, 255)
								colorCorr.Saturation = 0
								colorCorr.Contrast = 0
								triggerCatch(clone)
							end
						end
					end
				end
				
				-- Standard head tracking & proximity checks
				if not cloneData.IsChasing then
					local lookCFrame = CFrame.lookAt(cloneRoot.Position, Vector3.new(localPos.X, cloneRoot.Position.Y, localPos.Z))
					clone:PivotTo(lookCFrame)
					
					if (cloneRoot.Position - localPos).Magnitude < CONFIG.ProximityPenaltyRange then
						table.remove(activeClones, i)
						triggerPenalty(clone, sanityModule, cloneData.IsSoloVariant)
					else
						if not cloneData.NextChatTime or tick() >= cloneData.NextChatTime then
							cloneData.NextChatTime = tick() + math.random(120, 200) / 100
							
							local phrase = getRandomPhrase(cloneData.IsSoloVariant)
							local scrambled = scrambleText(phrase)
							ChatService:Chat(clone.Head, scrambled, Enum.ChatColor.Red)
						end
					end
				end
			else
				table.remove(activeClones, i)
			end
		end
	end)
end

return CloneModule
