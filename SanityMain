local Players = game:GetService("Players")
local localPlayer = Players.LocalPlayer

local SanityModule = {}
SanityModule.CurrentSanity = 100
SanityModule.MaxSanity = 100

local drainRate = 0.3
local isRunning = false
local onSanityChangedCallbacks = {}

-- UI Setup
local playerGui = localPlayer:WaitForChild("PlayerGui")
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "SanityGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

local bgBar = Instance.new("Frame")
bgBar.Size = UDim2.new(0, 200, 0, 20)
bgBar.Position = UDim2.new(0.5, -100, 0, 15)
bgBar.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
bgBar.BorderSizePixel = 0
bgBar.Parent = screenGui

local sanityBar = Instance.new("Frame")
sanityBar.Size = UDim2.new(1, 0, 1, 0)
sanityBar.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
sanityBar.BorderSizePixel = 0
sanityBar.Parent = bgBar

local sanityText = Instance.new("TextLabel")
sanityText.Name = "SanityTextLabel"
sanityText.Size = UDim2.new(1, 0, 1, 0)
sanityText.BackgroundTransparency = 1
sanityText.TextColor3 = Color3.fromRGB(255, 255, 255)
sanityText.TextSize = 14
sanityText.Font = Enum.Font.SourceSansBold
sanityText.Text = "Sanity: 100"
sanityText.Parent = bgBar

function SanityModule:StartDrain()
	if isRunning then return end
	isRunning = true
	
	task.spawn(function()
		while isRunning do
			task.wait(1)
			self.CurrentSanity = math.clamp(self.CurrentSanity - drainRate, 0, self.MaxSanity)
			
			-- Update local UI
			sanityBar.Size = UDim2.new(self.CurrentSanity / self.MaxSanity, 0, 1, 0)
			sanityText.Text = "Sanity: " .. math.floor(self.CurrentSanity)
			
			-- Notify external listener scripts (such as your future clone module)
			for _, callback in ipairs(onSanityChangedCallbacks) do
				task.spawn(callback, self.CurrentSanity)
			end
			
			-- Handle player death at 0 sanity
			if self.CurrentSanity <= 0 then
				local char = localPlayer.Character
				if char then
					local humanoid = char:FindFirstChildOfClass("Humanoid")
					if humanoid then
						humanoid.Health = 0
					end
				end
			end
		end
	end)
end

function SanityModule:GetSanity()
	return self.CurrentSanity
end

function SanityModule:ModifySanity(amount)
	self.CurrentSanity = math.clamp(self.CurrentSanity + amount, 0, self.MaxSanity)
	sanityBar.Size = UDim2.new(self.CurrentSanity / self.MaxSanity, 0, 1, 0)
	sanityText.Text = "Sanity: " .. math.floor(self.CurrentSanity)
	
	for _, callback in ipairs(onSanityChangedCallbacks) do
		task.spawn(callback, self.CurrentSanity)
	end
end

function SanityModule:OnSanityChanged(callback)
	table.insert(onSanityChangedCallbacks, callback)
end

return SanityModule
