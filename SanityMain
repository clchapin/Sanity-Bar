-- =================================================================
-- LOCAL SCRIPT: AllInOneSanitySystem (Place inside StarterPlayerScripts)
-- =================================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local Camera = workspace.CurrentCamera

local localPlayer = Players.LocalPlayer
local playerGui = localPlayer:WaitForChild("PlayerGui")

-- 1. Create Sanity Bar UI
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "SanityGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

local bgBar = Instance.new("Frame")
bgBar.Size = UDim2.new(0, 200, 0, 20)
bgBar.Position = UDim2.new(0.5, -100, 0, 15)
bgBar.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
bgBar.BorderSizePixel = 0
bgBar.Parent = screenGui

local sanityBar = Instance.new("Frame")
sanityBar.Size = UDim2.new(1, 0, 1, 0)
sanityBar.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
sanityBar.BorderSizePixel = 0
sanityBar.Parent = bgBar

local sanityText = Instance.new("TextLabel")
sanityText.Name = "SanityTextLabel"
sanityText.Size = UDim2.new(1, 0, 1, 0)
sanityText.BackgroundTransparency = 1
sanityText.TextColor3 = Color3.fromRGB(255, 255, 255)
sanityText.TextSize = 14
sanityText.Font = Enum.Font.SourceSansBold
sanityText.Text = "Sanity: 100"
sanityText.Parent = bgBar

local currentSanity = 100
local maxSanity = 100
local drainRate = 0.3
local colorCorrection = Instance.new("ColorCorrectionEffect")
colorCorrection.Parent = Lighting

local activeClones = {}
local isGlitching = false

-- 2. Passive Sanity Drain & UI Update
task.spawn(function()
	while true do
		task.wait(1)
		currentSanity = math.clamp(currentSanity - drainRate, 0, maxSanity)
		sanityBar.Size = UDim2.new(currentSanity / maxSanity, 0, 1, 0)
		sanityText.Text = "Sanity: " .. math.floor(currentSanity)
		
		if currentSanity <= 0 then
			local char = localPlayer.Character
			if char then
				local humanoid = char:FindFirstChildOfClass("Humanoid")
				if humanoid then
					humanoid.Health = 0
				end
			end
		end
	end
end)

-- 3. UI Text Jumbler (Active below 80% sanity, runs every 10 seconds)
task.spawn(function()
	while true do
		task.wait(10)
		if currentSanity < 80 then
			for _, gui in ipairs(playerGui:GetDescendants()) do
				if gui:IsA("TextLabel") and gui.Name ~= "SanityTextLabel" then
					local originalText = gui:GetAttribute("OriginalText")
					if not originalText then
						originalText = gui.Text
						gui:SetAttribute("OriginalText", originalText)
					end
					if originalText ~= "" and #originalText < 100 then
						local scrambled = ""
						for i = 1, #originalText do
							local char = originalText:sub(i, i)
							if char ~= " " then
								scrambled = scrambled .. string.char(math.random(33, 126))
							else
								scrambled = scrambled .. " "
							end
						end
						gui.Text = scrambled
					end
				end
			end
		end
	end
end)

-- Trigger 5-second glitch effect, transparency, and sanity penalty
local function triggerPenalty(cloneInstance)
	if isGlitching then return end
	isGlitching = true
	currentSanity = math.clamp(currentSanity - 15, 0, maxSanity)
	
	if cloneInstance and cloneInstance.Parent then
		for _, part in ipairs(cloneInstance:GetDescendants()) do
			if part:IsA("BasePart") then
				part.Transparency = 1
			elseif part:IsA("Decal") or part:IsA("Texture") then
				part.Transparency = 1
			end
		end
		task.delay(0.5, function()
			if cloneInstance and cloneInstance.Parent then
				cloneInstance:Destroy()
			end
		end)
	end
	
	task.spawn(function()
		local endTime = tick() + 5
		while tick() < endTime do
			colorCorrection.TintColor = Color3.fromRGB(200, 0, 255)
			colorCorrection.Saturation = -3
			colorCorrection.Contrast = 2
			Camera.CFrame = Camera.CFrame * CFrame.new(math.random(-1, 1) * 0.4, math.random(-1, 1) * 0.4, 0)
			RunService.RenderStepped:Wait()
		end
		colorCorrection.TintColor = Color3.fromRGB(255, 255, 255)
		colorCorrection.Saturation = 0
		colorCorrection.Contrast = 0
		isGlitching = false
	end)
end

-- 4. Dynamic Doppelgänger Spawner (Spawn rate scales directly with lower sanity)
task.spawn(function()
	while true do
		local waitTime = math.random(1, 3) + (currentSanity / 10)
		task.wait(waitTime)
		
		local otherPlayers = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= localPlayer and p.Character then
				local hrp = p.Character:FindFirstChild("HumanoidRootPart")
				local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
				if hrp and humanoid and humanoid.Health > 0 then
					table.insert(otherPlayers, p)
				end
			end
		end
		
		local localChar = localPlayer.Character
		if #otherPlayers > 0 and localChar and localChar:FindFirstChild("HumanoidRootPart") then
			local targetPlayer = otherPlayers[math.random(1, #otherPlayers)]
			if targetPlayer and targetPlayer.Character then
				local targetChar = targetPlayer.Character
				local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
				
				if targetHrp then
					targetChar.Archivable = true
					local clone = targetChar:Clone()
					targetChar.Archivable = false
					
					if clone then
						clone.Name = "WrongClone"
						
						for _, child in ipairs(clone:GetDescendants()) do
							if child:IsA("Script") or child:IsA("LocalScript") then
								child:Destroy()
							end
						end
						
						for _, child in ipairs(clone:GetChildren()) do
							if child:IsA("Accessory") and math.random() > 0.4 then
								child:Destroy()
							end
						end
						
						for _, part in ipairs(clone:GetDescendants()) do
							if part:IsA("BasePart") then
								part.Color = part.Color:Lerp(Color3.fromRGB(130, 20, 160), 0.35)
								part.CanCollide = false
							end
						end
						
						local head = clone:FindFirstChild("Head")
						local billboard, textLabel
						if head then
							billboard = Instance.new("BillboardGui")
							billboard.Size = UDim2.new(0, 200, 0, 50)
							billboard.StudsOffset = Vector3.new(0, 2.5, 0)
							billboard.AlwaysOnTop = true
							billboard.Parent = head
							
							textLabel = Instance.new("TextLabel")
							textLabel.Size = UDim2.new(1, 0, 1, 0)
							textLabel.BackgroundTransparency = 1
							textLabel.TextColor3 = Color3.fromRGB(180, 0, 255)
							textLabel.TextScaled = true
							textLabel.Font = Enum.Font.Code
							textLabel.Text = ""
							textLabel.Parent = billboard
						end
						
						local localRoot = localChar.HumanoidRootPart
						local randomAngle = math.random() * math.pi * 2
						local randomDist = math.random(3, 10)
						local rayOrigin = localRoot.Position + Vector3.new(math.cos(randomAngle) * randomDist, 10, math.sin(randomAngle) * randomDist)
						
						local raycastParams = RaycastParams.new()
						raycastParams.FilterDescendantsInstances = {localChar}
						raycastParams.FilterType = Enum.RaycastFilterType.Exclude
						
						local rayResult = Workspace:Raycast(rayOrigin, Vector3.new(0, -25, 0), raycastParams)
						local spawnPos = rayResult and rayResult.Position or (localRoot.Position + Vector3.new(randomDist, 0, 0))
						
						clone:PivotTo(CFrame.new(spawnPos + Vector3.new(0, 3, 0)))
						clone.Parent = Workspace
						
						local cloneData = {
							Instance = clone,
							TextLabel = textLabel,
							Billboard = billboard,
							SpawnTime = tick()
						}
						table.insert(activeClones, cloneData)
						
						task.delay(8, function()
							if clone and clone.Parent then
								clone:Destroy()
							end
						end)
					end
				end
			end
		end
	end
end)

-- 5. Chat listener to detect player chatting within 5 studs of a clone
localPlayer.Chatted:Connect(function(message)
	local localChar = localPlayer.Character
	if not localChar or not localChar:FindFirstChild("HumanoidRootPart") then return end
	local localPos = localChar.HumanoidRootPart.Position
	
	for _, cloneData in ipairs(activeClones) do
		local clone = cloneData.Instance
		if clone and clone.Parent and clone:FindFirstChild("HumanoidRootPart") then
			local cloneRoot = clone.HumanoidRootPart
			
			if (cloneRoot.Position - localPos).Magnitude <= 5 then
				if cloneData.TextLabel then
					local basePhrase = "you are so intriguing"
					local scrambled = ""
					for c = 1, #basePhrase do
						local char = basePhrase:sub(c, c)
						if char ~= " " and math.random() > 0.2 then
							scrambled = scrambled .. string.char(math.random(33, 126))
						else
							scrambled = scrambled .. char
						end
					end
					cloneData.TextLabel.Text = scrambled
					
					task.delay(2, function()
						if cloneData.TextLabel then
							cloneData.TextLabel.Text = ""
						end
					end)
				end
				break
			end
		end
	end
end)

-- 6. Render Loop for head tracking, distance penalty checks, and periodic jumbled chat
RunService.RenderStepped:Connect(function()
	local localChar = localPlayer.Character
	if not localChar or not localChar:FindFirstChild("HumanoidRootPart") then return end
	local localRoot = localChar.HumanoidRootPart
	local localPos = localRoot.Position
	
	for i = #activeClones, 1, -1 do
		local cloneData = activeClones[i]
		local clone = cloneData.Instance
		
		if clone and clone.Parent and clone:FindFirstChild("HumanoidRootPart") then
			local cloneRoot = clone.HumanoidRootPart
			
			local lookCFrame = CFrame.lookAt(cloneRoot.Position, Vector3.new(localPos.X, cloneRoot.Position.Y, localPos.Z))
			clone:PivotTo(lookCFrame)
			
			if (cloneRoot.Position - localPos).Magnitude < 3 then
				table.remove(activeClones, i)
				triggerPenalty(clone)
			else
				if not cloneData.NextChatTime or tick() >= cloneData.NextChatTime then
					cloneData.NextChatTime = tick() + math.random(90, 150) / 100
					
					if cloneData.TextLabel then
						local basePhrase = "you are so intriguing"
						local scrambled = ""
						for c = 1, #basePhrase do
							local char = basePhrase:sub(c, c)
							if char ~= " " and math.random() > 0.2 then
								scrambled = scrambled .. string.char(math.random(33, 126))
							else
								scrambled = scrambled .. char
							end
						end
						cloneData.TextLabel.Text = scrambled
						
						task.delay(1.2, function()
							if cloneData.TextLabel then
								cloneData.TextLabel.Text = ""
							end
						end)
					end
				end
			end
		else
			table.remove(activeClones, i)
		end
	end
end)
